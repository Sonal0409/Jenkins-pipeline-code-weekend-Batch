pipeline{

agent any

tools{
    maven 'mymaven'
}

stages{
     stage('Clone the repo'){
            steps{
            git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'

            }
        }
    stage('Test the code'){
        steps{
            sh 'mvn test'
            // wait for the approval from the admin, only than exeucte the next stage
            script{
                timeout(time: 10, unit: 'MINUTES'){
                input(id: 'BuildApproval', message: 'Do you want to proceed to build?',ok: 'Yes, Proceed')
            }
        }
        }
    }
    stage('Build the code'){
        steps{
            sh 'mvn package'
        }   
    }

}
}